{
  "rules": {
    "attr-lowercase": true,
    "attr-no-duplication": true,
    "attr-unsafe-chars": true,
    "attr-value-double-quotes": false,
    "doctype-first": true,
    "doctype-html5": true,
    "head-script": false,
    "href-abs-or-rel": false,
    "id-class-ad-disabled": true,
    "id-class-value": "underscore",
    "id-no-duplication": true,
    "inline-script": false,
    "inline-style": false,
    "input-attr-autocomplete": true,
    "input-btn-type": true,
    "input-type-text": true,
    "label-required": true,
    "li-br": true,
    "meta-charset": true,
    "meta-charset-utf8": true,
    "meta-viewport": true,
    "script-type": false,
    "style-disabled": false,
    "style-type": false,
    "tag-pair": true,
    "tag-self-close": false,
    "tagname-lowercase": true,
    "title-require": true
  },
  "ext": ["html"],
  "exclude": []
}
